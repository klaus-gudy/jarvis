{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jarvis-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3347
    },
    {
      "name": "prisma-studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "prisma",
        "studio",
        "--port",
        "5555",
        "--browser",
        "none"
      ],
      "port": 5555
    },
    {
      "name": "notifier",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../notifier",
        "run",
        "start"
      ],
      "port": 3350
    },
    {
      "name": "document-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../document-worker",
        "run",
        "start"
      ],
      "port": 3400
    },
    {
      "name": "automatifier",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../automatifier",
        "run",
        "start"
      ],
      "port": 4450
    },
    {
      "name": "rabbitmq",
      "url": "http://localhost:15682",
      "port": 15682
    },
    {
      "name": "minio",
      "url": "http://localhost:9001",
      "port": 9001
    }
  ]
}
