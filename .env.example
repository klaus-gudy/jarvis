# Copy to `.env` and fill in the placeholders:
#
#   cp .env.example .env
#
# Everything with a real value below is local infrastructure from
# docker-compose.yml and works as written after `docker compose up -d`.
# Everything marked CHANGE ME is a secret and must be generated per
# environment. `.env` is gitignored; this file is the only one committed.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Dev server port. Shifted off 3000 so a second Next app can run beside it.
PORT=3347

# Absolute origin of the public site. Read by lib/site.ts for the landing page
# canonical URL, Open Graph tags, sitemap.xml and robots.txt — all of which
# must be absolute to be valid.
#
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time, not read at runtime, so this
# must be set wherever `next build` runs (Railway service variables), not just
# on the running container.
NEXT_PUBLIC_SITE_URL=http://localhost:3347

# Signing key for session JWTs. CHANGE ME — 32 random bytes, base64:
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database — Postgres 16 (docker-compose.yml)
# ---------------------------------------------------------------------------

# Host port is 5439, not 5432, so a Postgres someone already runs locally does
# not collide with this one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/jarvis?schema=public"

# Normally unset, and deliberately absent from `.env`. Only `prisma migrate
# diff --from-migrations` needs it — which is how migrations are authored on
# this branch, because `migrate dev` sees the `documents` branch's ledger rows
# as drift and offers a full reset. See the 2026-08-18 decision-log entry in
# plan.md; create the database first, then export this for the one command:
#   docker exec jarvis-db psql -U postgres -c 'CREATE DATABASE jarvis_shadow;'
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5439/jarvis_shadow?schema=public"

# ---------------------------------------------------------------------------
# File storage — S3-compatible object store, one bucket for every organization
# ---------------------------------------------------------------------------

# Backs the FileAsset table. Keys are namespaced by organization
# (`organizations/<orgId>/...`), so tenancy is a key prefix rather than a
# bucket per customer — one set of credentials, and cross-organization reads
# are prevented by the application, not by the bucket.
#
# Local: MinIO from docker-compose.yml. The `minio-init` service creates the
# bucket on `docker compose up`, so these four work as written.
#   http://localhost:9000  - S3 API (this endpoint)
#   http://localhost:9001  - console, same credentials
#
# Production: Cloudflare R2. Only these four values change — endpoint becomes
# https://<account-id>.r2.cloudflarestorage.com and the keys become a scoped
# R2 API token rather than a root user.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=jarvis-files
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123

# ---------------------------------------------------------------------------
# Mail — RabbitMQ (docker-compose.yml)
# ---------------------------------------------------------------------------

# The queue the standalone mail service consumes from. Host port is shifted off
# 5672 for the same reason Postgres sits on 5439.
# Management UI: http://localhost:15682 (guest/guest).
RABBITMQ_URL=amqp://guest:guest@localhost:5682
MAIL_EXCHANGE=jarvis.emails
EVENTS_EXCHANGE=jarvis.events
MAIL_QUEUE=emails.outbound
# Stamped on every message as `service_name`, per the mail service's contract.
MAIL_SERVICE_NAME=Jarvis

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Shared secret for POST /api/cron/notifications — the scheduled half of the
# notification catalogue (lease expiry, overdue invoices). Point a scheduler at
# that route hourly with `Authorization: Bearer $CRON_SECRET`. The route
# refuses to run (503) when this is unset, rather than running open.
# CHANGE ME:
#   openssl rand -hex 32
CRON_SECRET=
