PORT=
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/jarvis?schema=public"
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CHECKOUT_URL=

# snippe webhook signing key (dashboard: Settings -> Webhook Secret, whsec_...).
# Server-only and read at runtime. Unset = /api/webhooks/snippe refuses every delivery.
SNIPPE_WEBHOOK_SECRET=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# RabbitMQ (docker-compose.yml) — one broker, three exchanges
RABBITMQ_URL=
EVENTS_EXCHANGE=
LEASE_CREATED_ROUTING_KEY=
DOCUMENTS_QUEUE=
DOCUMENT_STORED_ROUTING_KEY=

# Mail. The queue the standalone mail service consumes from.
MAIL_EXCHANGE=
MAIL_QUEUE=
MAIL_SERVICE_NAME=

INVITE_EMAIL_OWNERS_ONLY=

# Scheduled jobs.
CRON_SECRET=

AUTOMATIFIER_EXCHANGE=
LEASE_LIFECYCLE_QUEUE=
LEASE_RENEWAL_ROUTING_KEY=
LEASE_VACATING_ROUTING_KEY=
# notifier's HTTP API (../notifier), server-only — the member "SMS alerts" tab
# reads its audit trail. Unset = the tab says SMS history isn't configured.
NOTIFIER_API_URL=
