PORT=3347
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/jarvis?schema=public"
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3347

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=jarvis-files
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123

# RabbitMQ (docker-compose.yml) — one broker, two exchanges
RABBITMQ_URL=amqp://guest:guest@localhost:5682
EVENTS_EXCHANGE=jarvis.events
DOCUMENTS_QUEUE=JARVIS_DOCUMENTS_QUEUE
DOCUMENT_STORED_ROUTING_KEY=document.stored

# Mail. The queue the standalone mail service consumes from.
MAIL_EXCHANGE=jarvis.emails
MAIL_QUEUE=NOTIFIER_EMAIL_QUEUE

MAIL_SERVICE_NAME=Jarvis

INVITE_EMAIL_OWNERS_ONLY=true

# Scheduled jobs
CRON_SECRET=
