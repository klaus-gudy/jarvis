// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  properties  Property[]
  roles       Role[]
  invitations Invitation[]
  attachments Attachment[]
}

model Role {
  id   String @id @default(cuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, name])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  email      String?
  phone      String?
  name       String?
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  leases  Lease[]
  profile MemberProfile?

  /// Files *about* this member (ID documents, signed forms).
  attachments Attachment[] @relation("AttachmentSubject")
  /// Files this member uploaded, anywhere in the org.
  uploads     Attachment[] @relation("AttachmentUploader")

  @@unique([userId, organizationId])
}

model MemberProfile {
  id                       String   @id @default(cuid())
  occupation               String?
  nidaNumber               String?
  employer                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  membershipId String     @unique
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id          String         @id @default(cuid())
  name        String
  type        PropertyType
  category    String
  address     String
  status      PropertyStatus @default(ACTIVE)
  description String?
  amenities   String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  units       Unit[]
  attachments Attachment[]

  @@index([organizationId])
}

model Unit {
  id              String   @id @default(cuid())
  label           String
  rentAmount      Int
  minTenureMonths Int?
  /**
   * When true, a lease on this unit gets a successor created automatically
   * at term end, for minTenureMonths at the unit's current rentAmount.
   */
  autoRenew       Boolean  @default(false)
  unitType        String?
  floor           String?
  block           String?
  sizeSqm         Float?
  amenities       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases      Lease[]
  attachments Attachment[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

model Lease {
  id             String   @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  durationMonths Int
  /**
   * The rate actually agreed for this lease, per month. Defaults to the
   * unit's asking `rentAmount` but may be negotiated away from it, so it is
   * stored rather than inferred from `leaseAmount / durationMonths`.
   */
  monthlyRent    Int
  /**
   * The whole term's value: `monthlyRent * durationMonths`.
   */
  leaseAmount    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  invoice     Invoice?
  attachments Attachment[]

  /**
   * Renewal lineage: the auto-renewal job links a new lease back to the one
   * it succeeded, so it can be skipped on the next pass.
   */
  renewedFromId String? @unique
  renewedFrom   Lease?  @relation("LeaseRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Lease?  @relation("LeaseRenewal")
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Int
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseId String @unique
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([invoiceId])
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

/// A file held in object storage. The bytes live in the bucket; this row is
/// the record of what they are and what they belong to. Everything here is
/// storage-provider agnostic — `key` is an S3 object key, which R2, MinIO,
/// Supabase Storage and B2 all speak.
model Attachment {
  id          String         @id @default(cuid())
  /// Object key in the bucket, namespaced by organization so one org's prefix
  /// can be listed or purged without touching another's. Generated, never
  /// taken from the upload — a user-supplied name could escape the prefix.
  key         String         @unique
  /// The name the uploaded file had. Shown in the UI and sent back as the
  /// download filename; never used to build `key`.
  fileName    String
  contentType String
  sizeBytes   Int
  kind        AttachmentKind
  /// Which named document this file *is* — `contract`, `nida`, `photos` — from
  /// the slot list its owner type defines in `lib/attachment-slots.ts`. Null
  /// means an ad-hoc upload that fits none of them, which must carry a `title`
  /// instead. The key is stored rather than the label so renaming a label in
  /// config renames it everywhere, including on files already uploaded.
  slotKey     String?
  /// This file's own label, when it needs one the slot can't give: slots that
  /// hold several files (a property's photos) and ad-hoc uploads, where it is
  /// the only name the file has. Falls back to the slot label, then the
  /// filename — see `attachmentDisplayName`.
  title       String?
  createdAt   DateTime       @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who uploaded it. Nullable and `SetNull` so removing a member leaves
  /// their uploads in place rather than deleting the org's documents.
  uploadedById String?
  uploadedBy   Membership? @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Exactly one of the five owners below is set — enforced by a CHECK
  /// constraint in the migration, since Prisma cannot express it. Real FKs
  /// rather than a polymorphic (ownerType, ownerId) pair so the database
  /// cascades the rows when a parent goes.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  membershipId String?
  membership   Membership? @relation("AttachmentSubject", fields: [membershipId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([propertyId])
  @@index([unitId])
  @@index([leaseId])
  @@index([membershipId])
  @@index([paymentId])
}
