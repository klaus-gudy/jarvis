// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  properties  Property[]
  roles       Role[]
  invitations Invitation[]
}

model Role {
  id   String @id @default(cuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, name])
}

model User {
  id String @id @default(cuid())
  /// Optional because tenants are onboarded by staff and may only have a phone.
  /// Registration still requires it; the tenant form requires phone instead.
  email String? @unique
  phone String? @unique
  /// Null means the account cannot sign in yet — an assisted-onboarding tenant
  /// or an invitee who hasn't accepted. Login must reject null explicitly.
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id String @id @default(cuid())
  /// SHA-256 of the token. The raw token only ever exists in the invite link,
  /// so a database leak doesn't hand out working invitations.
  tokenHash  String           @unique
  email      String?
  phone      String?
  name       String?
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  leases Lease[]

  @@unique([userId, organizationId])
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id   String       @id @default(cuid())
  name String
  type PropertyType
  /// What the units are, shown next to the address: "Apartments", "Office suites".
  category String
  address  String
  /// Owner is not stored — it is derived from the organization's Owner-role member.
  status PropertyStatus @default(ACTIVE)
  description String?
  /// Shared facilities for the whole building: "CCTV", "Lift", "Borehole water".
  amenities String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  units Unit[]

  @@index([organizationId])
}

model Unit {
  id    String @id @default(cuid())
  label String
  /// Monthly rent in whole shillings. TZS has no subunit in practice, so an
  /// integer avoids both float rounding and Decimal serialization to clients.
  rentAmount Int
  /// Shortest lease the landlord will accept, in months.
  minTenureMonths Int?
  /// Unit-level type ("Studio", "2 Bedroom", "Shop") — distinct from
  /// Property.type, which is RESIDENTIAL/COMMERCIAL for the whole building.
  unitType String?
  /// Free text: "Ground", "Mezzanine" and "Basement" are all real floors.
  floor   String?
  block   String?
  sizeSqm Float?
  /// Amenities belonging to this unit ("Furnished", "Built-in wardrobes"),
  /// as opposed to Property.amenities which covers shared facilities.
  amenities String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases Lease[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

model Lease {
  id        String   @id @default(cuid())
  startDate DateTime
  /// Required: leases are always for a fixed term. The form takes a duration in
  /// months and this is derived from it, so there are no open-ended contracts.
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}
