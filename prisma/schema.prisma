// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  properties  Property[]
  roles       Role[]
  invitations Invitation[]
}

model Role {
  id   String @id @default(cuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, name])
}

model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id String @id @default(cuid())
  tokenHash  String           @unique
  email      String?
  phone      String?
  name       String?
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  leases          Lease[]
  profile         MemberProfile?
  paymentAccounts PaymentAccount[]

  @@unique([userId, organizationId])
}

enum PaymentAccountType {
  MOBILE_MONEY
  BANK
  LIPA
}

/**
 * Where a member asks tenants to send rent. Hung off Membership, not User or
 * Organization: an owner's accounts are their own, and someone who belongs to
 * two organizations should not have one org's accounts shown in the other.
 *
 * Deleting the membership takes the accounts with it — they describe that
 * relationship, and an orphaned account is a payment destination nobody owns.
 */
model PaymentAccount {
  id            String             @id @default(cuid())
  type          PaymentAccountType
  provider      String
  accountNumber String
  accountName   String?
  /** At most one per membership; enforced in lib/payment-accounts.ts writes. */
  isDefault     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

model MemberProfile {
  id                       String   @id @default(cuid())
  occupation               String?
  nidaNumber               String?
  employer                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  membershipId String     @unique
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id   String       @id @default(cuid())
  name String
  type PropertyType
  category String
  address  String
  status PropertyStatus @default(ACTIVE)
  description String?
  amenities String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  units Unit[]

  @@index([organizationId])
}

model Unit {
  id    String @id @default(cuid())
  label String
  rentAmount Int
  minTenureMonths Int?
  /** When true, a lease on this unit gets a successor created automatically
   * at term end, for minTenureMonths at the unit's current rentAmount. */
  autoRenew Boolean @default(false)
  unitType String?
  floor   String?
  block   String?
  sizeSqm Float?
  amenities String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases Lease[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

model Lease {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  durationMonths Int
  /** The rate actually agreed for this lease, per month. Defaults to the
   * unit's asking `rentAmount` but may be negotiated away from it, so it is
   * stored rather than inferred from `leaseAmount / durationMonths`. */
  monthlyRent    Int
  /** The whole term's value: `monthlyRent * durationMonths`. */
  leaseAmount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  invoice Invoice?

  /** Renewal lineage: the auto-renewal job links a new lease back to the one
   * it succeeded, so it can be skipped on the next pass. */
  renewedFromId String? @unique
  renewedFrom   Lease?  @relation("LeaseRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Lease?  @relation("LeaseRenewal")
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Int
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseId String @unique
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
