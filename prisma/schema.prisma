// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  properties    Property[]
  roles         Role[]
  invitations   Invitation[]
  notifications NotificationLog[]
  fileAssets    FileAsset[]
}

/**
 * What the notification sweep has already sent.
 * Only *scheduled* notifications are recorded. An event-driven one fires on
 * the event and can't repeat; a scheduled one is found by a query that will
 * find it again on the next run, so without this a cron every hour would mail
 * the same landlord every hour.
 * `dedupeKey` carries the occasion as well as the subject — `…:60` and `…:30`
 * for the two lease-expiry tiers, a week index for the overdue reminder — so
 * one row can't suppress a later, legitimately different notice. It is unique
 * rather than merely indexed: that makes a double send impossible even if two
 * cron hits overlap, which is the one failure a person actually notices.
 */
model NotificationLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  type      String
  sentAt    DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Role {
  id   String @id @default(cuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, name])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /**
   * When the address on this account was proven, by entering a code sent to
   * it. Null on a grandfathered account too — those were never verified, they
   * are simply not required to be.
   */
  emailVerifiedAt DateTime?

  /**
   * Whether this account is *blocked* until its address is verified. True only
   * for self-service registrations: someone who joined by invitation was
   * vouched for by a member of their organization, and every account that
   * existed before verification shipped keeps the `false` default, which is
   * what grandfathers them in without a data backfill.
   */
  emailVerificationRequired Boolean @default(false)

  memberships             Membership[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

/**
 * A pending email verification. Same shape and same rules as
 * `PasswordResetToken` — six digits, bcrypt-hashed, attempt-capped — but a
 * separate table on purpose: one table with a `purpose` column would mean a
 * single forgotten filter lets a verification code reset a password.
 */
model EmailVerificationToken {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * A pending password reset. Only the bcrypt hash of the 6-digit code is
 * stored — the code itself exists in the email and nowhere else.
 * Six digits is a million possibilities, which is not much: `attempts` is what
 * actually stops an online guess, since a code that survives the TTL is still
 * only one of a million. Rows are deleted once used, and every earlier one for
 * the same user is deleted when a new code is issued, so a user has at most
 * one live code at a time.
 */
model PasswordResetToken {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  email      String?
  phone      String?
  name       String?
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  leases          Lease[]
  profile         MemberProfile?
  paymentAccounts PaymentAccount[]

  /**
   * Files *about* this member — NIDA, passport, employment letter.
   */
  fileAssets         FileAsset[] @relation("FileAssetSubject")
  /**
   * Files this member put in the bucket, whoever they are about.
   */
  uploadedFileAssets FileAsset[] @relation("FileAssetUploader")

  @@unique([userId, organizationId])
}

enum PaymentAccountType {
  MOBILE_MONEY
  BANK
  LIPA
}

/**
 * Where a member asks tenants to send rent. Hung off Membership, not User or
 * Organization: an owner's accounts are their own, and someone who belongs to
 * two organizations should not have one org's accounts shown in the other.
 * Deleting the membership takes the accounts with it — they describe that
 * relationship, and an orphaned account is a payment destination nobody owns.
 */
model PaymentAccount {
  id            String             @id @default(cuid())
  type          PaymentAccountType
  provider      String
  accountNumber String
  accountName   String?
  /**
   * At most one per membership; enforced in lib/payment-accounts.ts writes.
   */
  isDefault     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

model MemberProfile {
  id                       String   @id @default(cuid())
  occupation               String?
  nidaNumber               String?
  employer                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  membershipId String     @unique
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id          String         @id @default(cuid())
  name        String
  type        PropertyType
  category    String
  address     String
  status      PropertyStatus @default(ACTIVE)
  description String?
  amenities   String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  units      Unit[]
  fileAssets FileAsset[]

  @@index([organizationId])
}

model Unit {
  id              String   @id @default(cuid())
  label           String
  rentAmount      Int
  minTenureMonths Int?
  /**
   * When true, a lease on this unit gets a successor created automatically
   * at term end, for minTenureMonths at the unit's current rentAmount.
   */
  autoRenew       Boolean  @default(false)
  unitType        String?
  floor           String?
  block           String?
  sizeSqm         Float?
  amenities       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases     Lease[]
  fileAssets FileAsset[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

model Lease {
  id             String   @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  durationMonths Int
  /**
   * The rate actually agreed for this lease, per month. Defaults to the
   * unit's asking `rentAmount` but may be negotiated away from it, so it is
   * stored rather than inferred from `leaseAmount / durationMonths`.
   */
  monthlyRent    Int
  /**
   * The whole term's value: `monthlyRent * durationMonths`.
   */
  leaseAmount    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  invoice    Invoice?
  fileAssets FileAsset[]

  /**
   * Renewal lineage: the auto-renewal job links a new lease back to the one
   * it succeeded, so it can be skipped on the next pass.
   */
  renewedFromId String? @unique
  renewedFrom   Lease?  @relation("LeaseRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Lease?  @relation("LeaseRenewal")
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Int
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseId String @unique
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  payments   Payment[]
  fileAssets FileAsset[]
}

model Payment {
  id        String   @id @default(cuid())
  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  fileAssets FileAsset[]

  @@index([invoiceId])
}

/**
 * What a stored file *is*. Deliberately not free text: the type decides which
 * subject a file may hang off, which slot on a page it fills, and — later —
 * who is allowed to see it, and none of that can be built on a string someone
 * typed.
 */
enum FileAssetType {
  // Organization
  BUSINESS_DOCUMENT

  // Property
  TITLE_DEED
  PROPERTY_PERMIT
  PROPERTY_PHOTO

  // Unit
  UNIT_DOCUMENT
  UNIT_PHOTO

  // Tenant (Membership)
  NIDA
  PASSPORT
  EMPLOYMENT_DOCUMENT
  TENANT_DOCUMENT

  // Lease
  LEASE_AGREEMENT
  LEASE_AMENDMENT
  LEASE_RENEWAL
  LEASE_TERMINATION

  // Invoice
  INVOICE_DOCUMENT

  // Payment
  PAYMENT_RECEIPT
  PAYMENT_PROOF

  OTHER
}

/**
 * One row per object in the bucket. The bucket stores opaque keys and bytes;
 * this table is the only thing that knows what a key means, what the file was
 * called when someone uploaded it, and what it belongs to. Nothing should read
 * or write the bucket without a row here — an object with no row is invisible
 * to the app and impossible to clean up on purpose.
 * **`organizationId` is required on every row, including rows with no other
 * subject.** One bucket serves every organization, so this column is the
 * tenancy boundary as well as the first path segment of the key: without it a
 * file cannot be listed, permission-checked, or deleted as part of an
 * organization. Rows where it is the *only* reference are the org's own
 * papers — a business licence belongs to the organization and to nothing else.
 * **Object keys are `organizations/<orgId>/<scope>/<scopeId>/<id><ext>`**, with
 * the `<scope>/<scopeId>` pair replaced by `organization` for org-level rows:
 * organizations/clx1.../leases/clx4.../clx9abc.pdf
 * organizations/clx1.../organization/clx7def.pdf
 * The file is named in the bucket by a fresh uuid, never by what the browser
 * sent: two tenants both uploading `scan.pdf` must not overwrite each other,
 * and an uploaded name can contain anything at all, `../` included. The name
 * the person chose survives in `fileName` for the download header, and the
 * extension comes from the verified MIME type. `objectKey` is unique because
 * two rows pointing at one object means deleting either one either strands an
 * object or destroys the other row's file.
 * **A file never crosses an organization.** That is not expressible as a
 * foreign key here: Unit, Lease, Invoice and Payment carry no `organizationId`
 * of their own, so the composite-FK trick would need a denormalized column and
 * a backfill on all four. Until then it is a write-path rule — resolve the
 * subject, compare its organization to this one, refuse the mismatch.
 */
model FileAsset {
  id        String @id @default(cuid())
  /**
   * Key within `STORAGE_BUCKET`. Never rebuilt from the other columns at read
   * time — a renamed convention would then stop resolving files already
   * stored under the old one.
   */
  objectKey String @unique
  /**
   * The name as uploaded. Display and `Content-Disposition` only.
   */
  fileName  String
  /**
   * MIME type as settled at upload (`application/pdf`, `image/jpeg`). Named
   * for the file, not the transport, because it is also what decides whether a
   * row renders as a thumbnail or a document chip.
   */
  fileType  String
  /**
   * `Int`, so a single file caps at 2 GB. Nothing a property manager uploads
   * comes near that, and `BigInt` would push a JS `bigint` into every
   * component that formats a size.
   */
  sizeBytes Int

  assetType FileAssetType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /**
   * Who uploaded it. `SET NULL` rather than cascade: a member can be removed
   * from an organization, and losing them must not take the title deed they
   * happened to upload with them.
   */
  uploadedById String?
  uploadedBy   Membership? @relation("FileAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /**
   * The subject. **At most one** of the six may be set — enforced by the
   * hand-written `FileAsset_at_most_one_owner` CHECK in the migration, since
   * Prisma's schema language cannot say it. Zero is legitimate and means the
   * organization itself; two would leave every read path guessing which
   * subject the file was actually filed under.
   * All six cascade: deleting a lease takes its agreement rows with it. The
   * *objects* do not follow — see the note in TASKS.md Phase 67.
   */
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String?
  membership   Membership? @relation("FileAssetSubject", fields: [membershipId], references: [id], onDelete: Cascade)

  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([propertyId])
  @@index([unitId])
  @@index([membershipId])
  @@index([leaseId])
  @@index([invoiceId])
  @@index([paymentId])
}
