// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  properties     Property[]
  roles          Role[]
  invitations    Invitation[]
  notifications  NotificationLog[]
  fileAssets     FileAsset[]
  fileAssetTypes FileAssetType[]
  leaseTemplates LeaseTemplate[]
  auditLogs      AuditLog[]
}

/// Append-only history of who changed what. Written in the same transaction as
/// the change it describes (`lib/audit.ts`); the app never updates or deletes it.
///
/// Actor ids are plain strings, not foreign keys: removing a member must not
/// erase or blank the record of what they did. `actorUserId` lasts longest (a
/// user outlives their memberships) and is what resolves a name.
model AuditLog {
  id String @id @default(cuid())

  /// `property.created`, `lease.updated`, `payment.deleted`, `member.role_changed`, …
  action     String
  /// Prisma model name of the subject (`Property`, `Lease`, …).
  entityType String
  entityId   String

  /// Null when the system acted — see `source`.
  actorMembershipId String?
  actorUserId       String?
  /// Where a write without a member came from (`automatifier`, `contract-filing`).
  /// Null for an ordinary signed-in request.
  source            String?

  /// `{ field: [before, after] }` for an update; the row's values for a create
  /// or delete. JSON-safe — dates as ISO strings.
  changes Json?

  /// Every record this entry belongs to, as `Type:id` keys — the entity itself
  /// plus its parents (`Payment:…`, `Invoice:…`, `Lease:…`, `Unit:…`,
  /// `Property:…`, `Membership:…`). What an Activity timeline filters on, so a
  /// unit's history finds its payments, even ones since deleted.
  subjects String[] @default([])

  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorMembershipId])
  @@index([subjects], type: Gin)
}

model NotificationLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  type      String
  sentAt    DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Which app a member gets, independent of the role's display name.
/// OWNER and TENANT are the two built-in roles (one of each per org);
/// every org-created role is STAFF.
enum RoleKind {
  OWNER
  STAFF
  TENANT
}

model Role {
  id   String @id @default(cuid())
  name String

  kind        RoleKind @default(STAFF)
  /// Permission keys from `lib/permissions.ts`. Only meaningful for STAFF:
  /// OWNER holds everything implicitly, TENANT holds nothing staff-side.
  permissions String[] @default([])
  /// One or two sentences shown on the Roles page. Null for the built-ins
  /// means "use the default wording in code" (`lib/roles.ts`).
  description String?

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, name])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerifiedAt DateTime?

  emailVerificationRequired Boolean @default(false)

  /**
   * Carried in the session JWT as `sv`; a token whose `sv` differs is dead.
   * Bumped on a password change or reset, which is how a 7-day cookie that
   * has been stolen stops working without waiting for it to expire.
   */
  sessionVersion Int @default(0)

  /**
   * Guided tours this person has finished or dismissed, and the
   * `TOURS_VERSION` the list was recorded against.
   * On `User` rather than `Membership`: which tours somebody has already sat
   * through follows the person, not whichever organization they happen to be
   * looking at. It replaces a localStorage key, which meant a tour greeted the
   * same person again on every new device and never at all on a device where
   * they had dismissed one by accident.
   * The version is stored beside the list instead of being baked into a key,
   * so a bumped `TOURS_VERSION` makes an older list *stale* rather than wrong:
   * `getToursSeen` returns nothing for a version it does not recognise, and a
   * rewritten set of tours greets everyone again with no migration to write.
   */
  toursSeen        String[] @default([])
  toursSeenVersion Int      @default(0)

  memberships             Membership[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  email      String?
  phone      String?
  name       String?
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("InvitationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("MembershipUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  leases          Lease[]
  profile         MemberProfile?
  paymentAccounts PaymentAccount[]
  paymentClaims   PaymentClaim[]

  fileAssets         FileAsset[] @relation("FileAssetSubject")
  uploadedFileAssets FileAsset[] @relation("FileAssetUploader")

  // Actor back-relations for the stamps above. Prisma requires them; nothing
  // reads from this side.
  createdProperties      Property[]       @relation("PropertyCreatedBy")
  updatedProperties      Property[]       @relation("PropertyUpdatedBy")
  createdUnits           Unit[]           @relation("UnitCreatedBy")
  updatedUnits           Unit[]           @relation("UnitUpdatedBy")
  createdLeases          Lease[]          @relation("LeaseCreatedBy")
  updatedLeases          Lease[]          @relation("LeaseUpdatedBy")
  createdInvoices        Invoice[]        @relation("InvoiceCreatedBy")
  updatedInvoices        Invoice[]        @relation("InvoiceUpdatedBy")
  createdLeaseTemplates  LeaseTemplate[]  @relation("LeaseTemplateCreatedBy")
  updatedLeaseTemplates  LeaseTemplate[]  @relation("LeaseTemplateUpdatedBy")
  createdRoles           Role[]           @relation("RoleCreatedBy")
  updatedRoles           Role[]           @relation("RoleUpdatedBy")
  createdPaymentAccounts PaymentAccount[] @relation("PaymentAccountCreatedBy")
  updatedPaymentAccounts PaymentAccount[] @relation("PaymentAccountUpdatedBy")
  createdMemberProfiles  MemberProfile[]  @relation("MemberProfileCreatedBy")
  updatedMemberProfiles  MemberProfile[]  @relation("MemberProfileUpdatedBy")
  createdMemberships     Membership[]     @relation("MembershipCreatedBy")
  updatedMemberships     Membership[]     @relation("MembershipUpdatedBy")
  createdInvitations     Invitation[]     @relation("InvitationCreatedBy")
  updatedInvitations     Invitation[]     @relation("InvitationUpdatedBy")
  createdPayments        Payment[]        @relation("PaymentCreatedBy")
  createdFileAssetTypes  FileAssetType[]  @relation("FileAssetTypeCreatedBy")
  reviewedPaymentClaims  PaymentClaim[]   @relation("PaymentClaimReviewedBy")

  @@unique([userId, organizationId])
}

enum PaymentAccountType {
  MOBILE_MONEY
  BANK
  LIPA
}

model PaymentAccount {
  id            String             @id @default(cuid())
  type          PaymentAccountType
  provider      String
  accountNumber String
  accountName   String?
  isDefault     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("PaymentAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("PaymentAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

model MemberProfile {
  id                       String   @id @default(cuid())
  occupation               String?
  nidaNumber               String?
  nationality              String?
  employer                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  signatureKey             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("MemberProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("MemberProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  membershipId String     @unique
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id          String         @id @default(cuid())
  name        String
  type        PropertyType
  category    String
  address     String
  status      PropertyStatus @default(ACTIVE)
  description String?
  amenities   String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("PropertyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  units      Unit[]
  fileAssets FileAsset[]

  @@index([organizationId])
}

model Unit {
  id              String   @id @default(cuid())
  label           String
  rentAmount      Int
  /// The renewal term, and the shortest a lease on this unit may run.
  /// Defaults to 6 rather than null: it is what a renewal's length is read
  /// from, and a unit without one renews nothing.
  minTenureMonths Int?     @default(6)
  /// The default for new leases on this unit; each `Lease` keeps its own copy.
  autoRenew       Boolean  @default(true)
  unitType        String?
  floor           String?
  block           String?
  sizeSqm         Float?
  amenities       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("UnitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("UnitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases     Lease[]
  fileAssets FileAsset[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

/// Stored lease lifecycle. Written at create/edit from the dates and moved
/// forward by the renewal sweep as dates pass (`syncLeaseStatuses`).
enum LeaseStatus {
  Upcoming
  Active
  Ended
  /// Ended and succeeded by a renewal lease (`renewedTo` set).
  Renewed
}

model Lease {
  id             String      @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  durationMonths Int
  status         LeaseStatus @default(Active)
  /// Whether this lease renews itself when its term is up. Copied from
  /// `Unit.autoRenew` (the unit's default) when the lease is created, editable
  /// per lease after that; a renewal inherits it from its predecessor.
  autoRenew      Boolean     @default(true)

  monthlyRent Int
  leaseAmount Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("LeaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("LeaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  invoice    Invoice?
  fileAssets FileAsset[]

  renewedFromId String? @unique
  renewedFrom   Lease?  @relation("LeaseRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Lease?  @relation("LeaseRenewal")

  @@index([status, endDate])
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Int
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  leaseId String @unique
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  payments      Payment[]
  paymentClaims PaymentClaim[]
  fileAssets    FileAsset[]
}

model Payment {
  id        String   @id @default(cuid())
  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  fileAssets FileAsset[]
  claim      PaymentClaim?

  @@index([invoiceId])
}

enum PaymentClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// A payment a tenant says they made. Never summed into a balance: confirming
/// one creates a real `Payment` (through `recordPayment`) and links it here.
model PaymentClaim {
  id         String             @id @default(cuid())
  amount     Int
  paidAt     DateTime
  method     String?
  notes      String?
  status     PaymentClaimStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?

  /// The staff member who confirmed or rejected it.
  reviewedById String?
  reviewedBy   Membership? @relation("PaymentClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// The tenant who submitted it.
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  /// Set on confirmation.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([invoiceId, status])
}

enum FileAssetSubject {
  ORGANIZATION
  PROPERTY
  UNIT
  MEMBERSHIP
  LEASE
  INVOICE
  PAYMENT
}

model FileAssetType {
  id String @id @default(cuid())

  /**
   * Stable machine name, `TITLE_DEED` shape. Derived from the label for a
   * custom type and never changed afterwards: it is what the migration matched
   * the old enum against, and what any future code would branch on.
   */
  key   String
  label String

  subject FileAssetSubject

  /**
   * Whether a subject may hold several of these. `false` is the "there is only
   * one of these" case — *the* NIDA, *the* signed agreement — which
   * `createDocument` turns into a 409 on the second upload.
   * Custom types default to `true`: someone inventing a type has not been
   * asked whether it is singular, and refusing their second upload with a
   * conflict they never opted into is the worse guess.
   */
  allowsMultiple Boolean @default(true)

  /**
   * Photos are a different surface — a carousel and a multi-file picker — and
   * a narrower MIME allowlist. Set from *where* the type was created rather
   * than asked, same as `subject`.
   */
  isPhoto Boolean @default(false)

  /**
   * Seeded from the original enum. System types are shared by every
   * organization, cannot be renamed or deleted, and are the only rows with a
   * null `organizationId`.
   */
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("FileAssetTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /**
   * Null for the seeded system types; set for one an organization added. A
   * type invented by one tenancy must not show up in another's dropdown — the
   * same boundary every other row here respects.
   */
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fileAssets FileAsset[]

  /**
   * Org-scoped keys are unique per organization. The system rows have a null
   * `organizationId`, which Postgres treats as distinct — so a *partial*
   * unique index covers those, hand-written in the migration because Prisma's
   * schema language cannot express one.
   */
  @@unique([organizationId, key])
  @@index([organizationId, subject])
}

model FileAsset {
  id        String @id @default(cuid())
  /**
   * Key within `STORAGE_BUCKET`. Never rebuilt from the other columns at read
   * time — a renamed convention would then stop resolving files already
   * stored under the old one.
   */
  objectKey String @unique
  /**
   * The name as uploaded. Display and `Content-Disposition` only.
   */
  fileName  String
  /**
   * MIME type as settled at upload (`application/pdf`, `image/jpeg`). Named
   * for the file, not the transport, because it is also what decides whether a
   * row renders as a thumbnail or a document chip.
   */
  fileType  String
  /**
   * `Int`, so a single file caps at 2 GB. Nothing a property manager uploads
   * comes near that, and `BigInt` would push a JS `bigint` into every
   * component that formats a size.
   */
  sizeBytes Int
  /**
   * Generated contracts only: the signature placeholders drawn into this file
   * (`landlord_signature`, `tenant_signature`). Non-empty means a signed
   * contract, which `deleteDocument` refuses to remove. Empty for every other
   * file, and for contracts filed before 2026-10-08.
   */
  signedBy  String[] @default([])

  /**
   * What kind of document this is. A foreign key rather than an enum since
   * 2026-08-25 — see `FileAssetType`. Restricted, never cascading: deleting a
   * type that files still point at would silently destroy those files, so the
   * database refuses and the app has to say so.
   */
  assetTypeId String
  assetType   FileAssetType @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /**
   * Who uploaded it. `SET NULL` rather than cascade: a member can be removed
   * from an organization, and losing them must not take the title deed they
   * happened to upload with them.
   */
  uploadedById String?
  uploadedBy   Membership? @relation("FileAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /**
   * The subject. **At most one** of the six may be set — enforced by the
   * hand-written `FileAsset_at_most_one_owner` CHECK in the migration, since
   * Prisma's schema language cannot say it. Zero is legitimate and means the
   * organization itself; two would leave every read path guessing which
   * subject the file was actually filed under.
   * All six cascade: deleting a lease takes its agreement rows with it. The
   * *objects* do not follow — see the note in TASKS.md Phase 67.
   */
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  membershipId String?
  membership   Membership? @relation("FileAssetSubject", fields: [membershipId], references: [id], onDelete: Cascade)

  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([assetTypeId])
  @@index([propertyId])
  @@index([unitId])
  @@index([membershipId])
  @@index([leaseId])
  @@index([invoiceId])
  @@index([paymentId])
}

model LeaseTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  language    String  @default("en")
  body        String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who created / last changed this row. Null for rows from before 2026-10-01,
  /// system writes (consumers, cron) and removed members; `AuditLog` keeps the rest.
  createdById String?
  createdBy   Membership? @relation("LeaseTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   Membership? @relation("LeaseTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// One row per verified webhook delivery from snippe, the hosted checkout that
/// takes *our* subscription money. Deliberately not `Payment`: that model is a
/// landlord recording a tenant's rent, and the two ledgers must never be
/// summed, filtered or exported together by accident.
///
/// A row exists only after `lib/billing/snippe-webhook.ts` has checked the
/// HMAC signature, so everything here was said by snippe — unlike the
/// `/payment-complete` page, whose query string anyone can type.
///
/// Stored as an append-only log rather than folded into a subscription: there
/// is no subscription model yet, and a payment made from the public pricing
/// page arrives with no organization attached (the visitor has no account at
/// that point). Keeping every event, with its full payload, means attribution
/// can be decided later without anything having been thrown away.
model BillingEvent {
  id            String    @id @default(cuid())
  /// snippe's event id (`evt_…`). Unique, so a redelivery is a no-op — snippe
  /// retries up to five times and says outright that handlers must be idempotent.
  eventId       String    @unique
  /// `payment.completed`, `payment.failed`, `payment.voided`, `payment.expired`, …
  type          String
  /// snippe's payment reference (`pi_…` / `PAY…`), what support will ask for.
  reference     String
  status        String?
  /// Whole shillings, as snippe sends them (`amount.value`).
  amount        Int?
  currency      String?
  /// Channel provider, e.g. `mpesa`, `airtel`.
  provider      String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  /// From the `?meta=` blob `planCheckoutHref` attaches to the checkout link.
  plan          String?
  billing       String?
  /// The verified body, verbatim. The columns above are conveniences for
  /// querying; this is the record.
  payload       Json
  /// When snippe says it happened (`completed_at` / `failed_at` / `created_at`).
  occurredAt    DateTime?
  receivedAt    DateTime  @default(now())

  @@index([reference])
  @@index([customerEmail])
  @@index([type, receivedAt])
}
